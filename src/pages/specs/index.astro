---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { formatDate } from '../../lib/meta';

const specs = (await getCollection('specs')).sort((a, b) => a.data.title.localeCompare(b.data.title));

const meta = [
  { key: 'title', value: 'specs', big: true },
  { key: 'subtitle', value: 'specifications published under agentid.at' },
  { key: 'count', value: String(specs.length) },
];
---
<Page title="specs — agentid.at" description="Specifications published under agentid.at" meta={meta}>
  <h1>Specs</h1>
  <div class="md-table">
    <table>
      <thead>
        <tr><th>spec</th><th>status</th><th>updated</th><th>summary</th></tr>
      </thead>
      <tbody>
        {specs.map((spec) => (
          <tr>
            <td><a href={`/specs/${spec.id}/`}>{spec.data.title}</a></td>
            <td>{spec.data.status ?? '—'}</td>
            <td>{spec.data.updated ? formatDate(spec.data.updated) : '—'}</td>
            <td>{spec.data.subtitle ?? ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Page>
