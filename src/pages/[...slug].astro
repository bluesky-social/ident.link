---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Page from '../layouts/Page.astro';
import { docMeta } from '../lib/meta';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((doc) => ({
    params: { slug: doc.id === 'index' ? undefined : doc.id },
    props: { doc },
  }));
}

const { doc } = Astro.props as { doc: CollectionEntry<'docs'> };
const { Content, headings } = await render(doc);

const title =
  doc.id === 'index'
    ? [doc.data.title, doc.data.subtitle].filter(Boolean).join(' — ')
    : `${doc.data.title} — agentid.at`;
---
<Page title={title} description={doc.data.subtitle} meta={docMeta(doc.data)} headings={headings}>
  <Content />
</Page>
